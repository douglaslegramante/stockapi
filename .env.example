# Copie este arquivo para ".env" e preencha com os SEUS valores.
# O arquivo .env NÃO vai para o Git (está no .gitignore): ele guarda segredos.

# --- Banco de dados (MySQL) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=stockapi

# --- Servidor ---
PORT=3000

# --- Autenticação (JWT) ---
# Texto secreto usado para assinar os tokens. Use qualquer frase longa e
# difícil de adivinhar. Quem souber esse segredo consegue forjar tokens!
# ou gere uma frase secreta aleatória com o comando abaixo.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_uma_frase_longa_e_secreta
